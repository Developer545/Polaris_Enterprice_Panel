NODE_ENV=production
PORT=4000

# Replace 192.168.1.20 with the fixed LAN IP of the server PC.
CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010,http://192.168.1.20:3010

CONTROL_PLANE_DATABASE_URL=postgresql://pos_dte:pos_dte_local_password@localhost:5432/pos_dte_control?schema=public
SHARED_TENANT_DATABASE_URL=postgresql://pos_dte:pos_dte_local_password@localhost:5432/pos_dte_tenant?schema=public
REDIS_URL=redis://localhost:6379

# Generate unique production secrets per customer.
JWT_ACCESS_SECRET=change-me-local-access-secret-32chars
JWT_REFRESH_SECRET=change-me-local-refresh-secret-32chars
JWT_ADMIN_SECRET=change-me-local-admin-secret-32chars
ENCRYPTION_KEY=1111111111111111111111111111111111111111111111111111111111111111

# Optional for Electron LAN defaults.
WEB_URL=http://192.168.1.20:3010
API_URL=http://192.168.1.20:4000
