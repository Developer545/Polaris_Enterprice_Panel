# ============================================================
# CONTROL PLANE DATABASE (Neon PostgreSQL)
# ============================================================
CONTROL_PLANE_DATABASE_URL="postgresql://user:password@host/control_plane_db?sslmode=require"

# ============================================================
# SHARED TENANT DATABASE (Neon PostgreSQL - tenants NEON_SHARED)
# ============================================================
SHARED_TENANT_DATABASE_URL="postgresql://user:password@host/shared_tenant_db?sslmode=require"

# ============================================================
# JWT
# ============================================================
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_ADMIN_SECRET="change-me-admin-secret-min-32-chars"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# ============================================================
# REDIS (Upstash o local)
# ============================================================
REDIS_URL="redis://localhost:6379"
# Para Upstash:
# REDIS_URL="rediss://default:password@host:port"

# ============================================================
# API
# ============================================================
PORT=4000
NODE_ENV="development"
API_URL="http://localhost:4000"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# ============================================================
# NEXT.JS WEB APP
# ============================================================
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ============================================================
# NEXT.JS ADMIN APP
# ============================================================
NEXT_PUBLIC_ADMIN_API_URL="http://localhost:4000"

# ============================================================
# CLOUDINARY (imágenes online)
# ============================================================
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ============================================================
# EMAIL (Resend)
# ============================================================
RESEND_API_KEY=""
RESEND_FROM="noreply@speeddan.com"

# ============================================================
# ENCRYPTION (para credenciales Hacienda en BD)
# Genera con: openssl rand -hex 32
# ============================================================
ENCRYPTION_KEY="change-me-32-byte-hex-key-here-00"

# ============================================================
# ELECTRON AUTO-UPDATER (GitHub Releases)
# ============================================================
GH_TOKEN=""
