// Control Plane Schema
// Manages: tenants, plans, admin users, platform audit
// DB: CONTROL_PLANE_DATABASE_URL

generator client {
  provider = "prisma-client-js"
  output   = "../generated/control-plane"
}

datasource db {
  provider = "postgresql"
  url      = env("CONTROL_PLANE_DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum DbStrategy {
  NEON_SHARED     // Shared Neon DB — tenantId row isolation
  NEON_DEDICATED  // Dedicated Neon DB per tenant
  LOCAL_DEDICATED // Client's own PostgreSQL server
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum LicenseStatus {
  PENDING    // generada, sin activar
  ACTIVE     // en uso
  SUSPENDED  // suspendida manualmente
  EXPIRED    // venció fecha de expiración
}

enum AdminRole {
  SUPER_ADMIN
  OPERATOR
  SUPPORT
}

// ─── Models ──────────────────────────────────────────────────────────────────

model Tenant {
  id          String       @id @default(cuid())
  slug        String       @unique  // used as X-Tenant-Slug header
  name        String
  email       String
  phone       String?
  planId      String
  plan        Plan         @relation(fields: [planId], references: [id])
  dbStrategy  DbStrategy   @default(NEON_SHARED)
  dbUrl       String?      // encrypted — only for DEDICATED strategies
  status      TenantStatus @default(TRIAL)
  trialEndsAt DateTime?
  licenseKey       String       @unique @default(cuid())
  appVersion       String?      // last reported Electron version
  lastSeenAt       DateTime?
  // Per-tenant feature flags — managed by SuperAdmin
  modules          Json         @default("{}")  // { "pos": true, "dte": true, ... }
  dteAllowedTypes  String[]     // DTE types admin allows: ["01","03","05","06","11"]
  provisioned      Boolean      @default(false) // true once first company+user created
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  companies        TenantCompany[]
  auditLogs        PlatformAuditLog[]
  licenses         License[]
}

// Maps tenant → companies created in the tenant DB
model TenantCompany {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyRef String   // Company.id in the tenant DB
  name       String   // denormalized for quick display
  createdAt  DateTime @default(now())

  @@index([tenantId])
}

model Plan {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  price        Decimal  @db.Decimal(10, 2)
  maxCompanies Int      @default(1)
  maxBranches  Int      @default(1)
  maxUsers     Int      @default(5)
  features     Json     @default("{}")  // { "dte": true, "reports": false, ... }
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenants      Tenant[]
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  password     String    // bcryptjs hash
  name         String
  role         AdminRole @default(OPERATOR)
  isActive     Boolean   @default(true)
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  auditLogs    PlatformAuditLog[]
}

// ─── License ──────────────────────────────────────────────────────────────────
// La clave en texto plano NUNCA se guarda.
// keyHash = HMAC-SHA256(rawKey.replace(/-/g,'').toUpperCase(), LICENSE_HMAC_SECRET)
// Sin ese secreto es imposible validar aunque roben la BD.

model License {
  id             String        @id @default(cuid())
  keyHash        String        @unique  // HMAC-SHA256 — nunca la clave real
  keyPreview     String        // "ABCD-****-****-WXYZ" — seguro mostrar
  label          String?       // nota: "Cliente: Ferretería García"
  status         LicenseStatus @default(PENDING)
  plan           String        @default("LOCAL")
  expiresAt      DateTime?
  tenantId       String?
  tenant         Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  // HWID binding — null hasta primera activación
  hwid           String?       // hash del machine ID del cliente
  // Módulos habilitados remotamente (todos en el bundle, solo se activan los de aquí)
  enabledModules String[]      @default(["pos", "ventas", "clientes", "inventario", "servicios"])
  activatedAt    DateTime?
  lastSeenAt     DateTime?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  dailyStats     DteDailyLog[]

  @@index([tenantId])
}

// Registro diario de DTE emitidos por cada licencia (heartbeat nocturno)
model DteDailyLog {
  id        String   @id @default(cuid())
  licenseId String
  license   License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  stats     Json     // { "01": 5, "03": 2 } — count por tipoDte
  createdAt DateTime @default(now())

  @@unique([licenseId, date])
  @@index([licenseId])
}

model PlatformAuditLog {
  id        String     @id @default(cuid())
  adminId   String?
  admin     AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  tenantId  String?
  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  action    String     // e.g. TENANT_CREATED, PLAN_CHANGED, TENANT_SUSPENDED
  entity    String
  entityId  String?
  payload   Json?
  ip        String?
  createdAt DateTime   @default(now())

  @@index([tenantId])
  @@index([adminId])
}
