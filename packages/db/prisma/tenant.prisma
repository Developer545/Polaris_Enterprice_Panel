// Tenant Schema — POS DTE El Salvador
// All models include tenantId for row-level isolation
// DB: SHARED_TENANT_DATABASE_URL (shared) or dynamic URL (dedicated)

generator client {
  provider = "prisma-client-js"
  output   = "../generated/tenant"
}

datasource db {
  provider = "postgresql"
  url      = env("SHARED_TENANT_DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum DteStatus {
  QUEUED    // creado dentro de la tx de venta — outbox durable antes de Redis
  PENDING   // worker tomó el job, procesando
  ACCEPTED
  REJECTED
  CONTINGENCY
  ANNULLED
  ERROR
}

enum DteAmbiente {
  TEST
  PROD
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
  CANCELLED
}

enum AccountPayableStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

enum InventoryMovementType {
  IN        // entrada: compra, ajuste positivo
  OUT       // salida: venta, ajuste negativo
  ADJUST    // ajuste manual (puede ser + o -)
  TRANSFER  // transferencia entre sucursales
}

enum AccountReceivableStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

// ─── Company & Branch ─────────────────────────────────────────────────────────

model Company {
  id                       String      @id @default(cuid())
  tenantId                 String
  name                     String
  comercialName            String?
  nit                      String?
  nrc                      String?
  actividadEconomica       String?
  actividadEconomicaCodigo String?
  logoUrl                  String?     // Cloudinary URL or local userData/ path
  address                  String?
  departamentoCod          String?
  municipioCod             String?
  distritoCod              String?
  phone                    String?
  email                    String?
  giro                     String?     // Descripción del giro comercial (DTE)
  tipoDocumento            String?     // CAT-022: '36'=NIT, '13'=DUI (persona natural)
  esGranContribuyente      Boolean     @default(false)
  sujetoRetencionIva1      Boolean     @default(true)
  // DTE — Hacienda credentials (AES-256 encrypted)
  haciendaUserEnc          String?
  haciendaPwdEnc           String?
  certDataEnc              String?     // .p12 base64 encrypted
  certPwdEnc               String?
  dteAmbiente              DteAmbiente @default(TEST)
  dteEnabledTypes          String[]    // e.g. ["01","03","05"] — managed from settings
  // SMTP por empresa — envío automático de correos DTE (opcional; fallback a env SMTP_HOST)
  smtpHost                 String?
  smtpPort                 Int?
  smtpUser                 String?
  smtpPwdEnc               String?     // AES-256 encrypted
  smtpFrom                 String?     // e.g. "Empresa <noreply@empresa.com>"
  smtpSecure               Boolean     @default(false)
  // Business feature toggles
  enableCommissions        Boolean     @default(false)  // activate commission system
  enableSalesGoals         Boolean     @default(false)  // activate sales goals module
  isActive                 Boolean     @default(true)
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  branches          Branch[]
  roles             Role[]
  users             User[]
  clients           Client[]
  categories        Category[]
  services          Service[]
  unitOfMeasures    UnitOfMeasure[]
  cashRegisters      CashRegister[]
  sales              Sale[]
  dteNumberControls  DteNumberControl[]
  suppliers          Supplier[]
  purchaseOrders     PurchaseOrder[]
  accountsPayable    AccountPayable[]
  expenseCategories  ExpenseCategory[]
  expenses           Expense[]
  employees          Employee[]
  employeeCargos     EmployeeCargo[]
  employeeGroups     EmployeeGroup[]
  payrollPeriods     PayrollPeriod[]
  auditLogs          AuditLog[]
  inventoryMovements InventoryMovement[]
  accountsReceivable AccountReceivable[]
  salesGoals         SalesGoal[]
  commissionRecords  CommissionRecord[]

  @@index([tenantId])
}

model Branch {
  id              String  @id @default(cuid())
  tenantId        String
  companyId       String
  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  address         String?
  departamentoCod String?
  municipioCod    String?
  distritoCod     String?
  phone           String?
  // DTE — Point of sale codes
  tipoEstablecimiento String?  // CAT-009: '01'=Matriz, '02'=Sucursal, '07'=Fijo, etc.
  codEstableMH        String?
  codPuntoVentaMH     String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users              UserBranch[]
  cashRegisters      CashRegister[]
  sales              Sale[]
  inventoryMovements InventoryMovement[]
  branchInventories  BranchInventory[]
  clients            Client[]
  expenses           Expense[]
  accountsPayable    AccountPayable[]
  accountsReceivable AccountReceivable[]
  employees          Employee[]

  @@index([tenantId, companyId])
}

// ─── Auth & Users ────────────────────────────────────────────────────────────

model Role {
  id          String   @id @default(cuid())
  tenantId    String
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  permissions Json     @default("{}")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]

  @@unique([companyId, name])
  @@index([tenantId, companyId])
}

model User {
  id           String     @id @default(cuid())
  tenantId     String
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email        String
  password     String
  name         String
  phone        String?
  avatar       String?
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  isActive     Boolean    @default(true)
  failedLogins Int        @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sessions      Session[]
  branches      UserBranch[]
  sales         Sale[]
  openedCashRegisters CashRegister[] @relation("OpenedBy")
  closedCashRegisters CashRegister[] @relation("ClosedBy")
  inventoryMovements  InventoryMovement[]

  @@unique([email, companyId])
  @@index([tenantId, companyId])
}

model UserBranch {
  userId   String
  branchId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String    @unique
  familyId     String
  deviceInfo   String?
  ip           String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

// ─── Clients ─────────────────────────────────────────────────────────────────

model Client {
  id                       String   @id @default(cuid())
  tenantId                 String
  companyId                String
  company                  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId                 String?
  branch                   Branch?  @relation(fields: [branchId], references: [id])
  name                     String
  comercialName            String?
  tipoDocumento            String?
  numDocumento             String?
  nrc                      String?
  actividadEconomica       String?
  actividadEconomicaCodigo String?
  departamentoCod          String?
  municipioCod             String?
  distritoCod              String?
  email                    String?
  phone                    String?
  address                  String?
  esCreditoFiscal          Boolean  @default(false)
  esGranContribuyente      Boolean  @default(false)
  retieneIva1              Boolean  @default(false)
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  sales             Sale[]
  accountsReceivable AccountReceivable[]

  @@index([tenantId, companyId])
  @@index([tenantId, companyId, branchId])
  @@index([tenantId, companyId, numDocumento])
  @@index([tenantId, companyId, nrc])
}

// ─── Services / Products ─────────────────────────────────────────────────────

model Category {
  id          String    @id @default(cuid())
  tenantId    String
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  color       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  services    Service[]

  @@index([tenantId, companyId])
}

model Service {
  id          String    @id @default(cuid())
  tenantId    String
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  name        String
  description String?
  sku         String?
  barcode     String?
  price             Decimal   @db.Decimal(10, 4)       // precio estándar
  priceWholesale    Decimal?  @db.Decimal(10, 4)       // precio mayoreo
  priceDistribution Decimal?  @db.Decimal(10, 4)       // precio distribución
  priceSpecial      Decimal?  @db.Decimal(10, 4)       // precio especial
  cost              Decimal   @default(0) @db.Decimal(10, 4)
  commissionAmount  Decimal?  @db.Decimal(10, 4)       // comisión fija tipo A por unidad vendida
  imageUrl    String?
  emoji       String?   @default("")  // emoji visual para POS tiles
  // DTE
  tipoItem    String    @default("2")  // "1"=bien "2"=servicio "3"=ambos "4"=otro
  uniMedida   Int       @default(59)   // catálogo MH — 59=Unidad
  // Inventory
  trackStock       Boolean  @default(false)
  stock            Decimal  @default(0) @db.Decimal(12, 4)
  minStock         Decimal  @default(0) @db.Decimal(12, 4)
  // Units / Fractions (barber-pro pattern)
  purchaseUnit     String?  // unidad de compra: "Galón", "Caja", "Libra"
  saleUnitId       String?
  saleUnit         UnitOfMeasure? @relation(fields: [saleUnitId], references: [id])
  conversionFactor Decimal  @default(1) @db.Decimal(10, 4) // 1 purchaseUnit = N saleUnits
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  saleItems          SaleItem[]
  purchaseOrderItems PurchaseOrderItem[]
  inventoryMovements InventoryMovement[]
  branchInventories  BranchInventory[]

  @@index([tenantId, companyId])
  @@index([tenantId, companyId, sku])
  @@index([tenantId, companyId, barcode])
}

// ─── Units of Measure (fraccionable products) ─────────────────────────────────

model UnitOfMeasure {
  id        String    @id @default(cuid())
  tenantId  String
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String    // "Onza", "Vaso", "Libra", "Litro fraccionado"
  symbol    String?   // "oz", "vaso", "lb", "L"
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  products  Service[]

  @@unique([companyId, name])
  @@index([tenantId, companyId])
  @@map("units_of_measure")
}

// ─── Cash Register ────────────────────────────────────────────────────────────

model CashRegister {
  id              String    @id @default(cuid())
  tenantId        String
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId        String
  branch          Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  openedById      String
  openedBy        User      @relation("OpenedBy", fields: [openedById], references: [id])
  closedById      String?
  closedBy        User?     @relation("ClosedBy", fields: [closedById], references: [id])
  openedAt        DateTime  @default(now())
  closedAt        DateTime?
  openingBalance     Decimal   @default(0) @db.Decimal(10, 2)
  closingBalance     Decimal?  @db.Decimal(10, 2)
  difference         Decimal?  @db.Decimal(10, 2)
  montoEsperado      Decimal?  @db.Decimal(10, 2)
  totalEfectivo      Decimal?  @db.Decimal(10, 2)
  totalTarjeta       Decimal?  @db.Decimal(10, 2)
  totalTransferencia Decimal?  @db.Decimal(10, 2)
  totalQR            Decimal?  @db.Decimal(10, 2)
  totalVentas        Decimal?  @db.Decimal(10, 2)
  cantidadVentas     Int?
  arqueoCaja         Json?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  sales              Sale[]

  @@index([tenantId, branchId])
}

// ─── Sales ────────────────────────────────────────────────────────────────────

model Sale {
  id               String        @id @default(cuid())
  tenantId         String
  companyId        String
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId         String
  branch           Branch        @relation(fields: [branchId], references: [id])
  cashRegisterId   String?
  cashRegister     CashRegister? @relation(fields: [cashRegisterId], references: [id])
  clientId         String?
  client           Client?       @relation(fields: [clientId], references: [id])
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  sellerId         String?       // vendedor asignado (puede diferir del cajero userId)
  sellerEmployee   Employee?     @relation("SaleSeller", fields: [sellerId], references: [id])
  tipoDte          String        @default("01")  // 01=CF 03=CCF 05=NC 06=ND
  condicionOperacion String      @default("1")   // 1=Contado 2=Crédito
  // Totals (Decimal — NO float arithmetic)
  totalNoSuj       Decimal       @default(0) @db.Decimal(10, 2)
  totalExenta      Decimal       @default(0) @db.Decimal(10, 2)
  totalGravada     Decimal       @default(0) @db.Decimal(10, 2)
  totalIva         Decimal       @default(0) @db.Decimal(10, 2)
  ivaRete1         Decimal       @default(0) @db.Decimal(10, 2)
  reteRenta        Decimal       @default(0) @db.Decimal(10, 2)
  totalDescuento   Decimal       @default(0) @db.Decimal(10, 2)
  totalPagar       Decimal       @db.Decimal(10, 2)
  notes            String?
  // Documento relacionado (para NC tipo 05 y ND tipo 06)
  docRelTipoDte          String?  // Tipo DTE del documento original (ej. '03')
  docRelNumeroControl    String?  // Número de control del original
  docRelCodigoGeneracion String?  // UUID del original
  docRelTipoGeneracion   Int      @default(1)  // 1=Normal 2=Contingencia
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  items              SaleItem[]
  payments           Payment[]
  dteDocument        DteDocument?
  inventoryMovements InventoryMovement[]
  accountReceivable  AccountReceivable?
  commissionRecords  CommissionRecord[]

  @@index([tenantId, companyId, branchId])
  @@index([tenantId, companyId, createdAt])
  @@index([tenantId, companyId, cashRegisterId])
}

model SaleItem {
  id           String   @id @default(cuid())
  saleId       String
  sale         Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId    String
  product      Service  @relation(fields: [productId], references: [id])
  productName  String
  quantity     Decimal  @db.Decimal(10, 4)
  unitPrice    Decimal  @db.Decimal(10, 4)
  discount     Decimal  @default(0) @db.Decimal(10, 4)
  ventaNoSuj   Decimal  @default(0) @db.Decimal(10, 4)
  ventaExenta  Decimal  @default(0) @db.Decimal(10, 4)
  ventaGravada Decimal  @default(0) @db.Decimal(10, 4)
  ivaItem      Decimal  @default(0) @db.Decimal(10, 4)
  tipoItem     String   @default("2")
  uniMedida    Int      @default(59)
  sellerId     String?  // vendedor específico de este ítem (override del vendedor de la venta)
  seller       Employee? @relation("SaleItemSeller", fields: [sellerId], references: [id])
  priceType    String?  // 'STANDARD'|'WHOLESALE'|'DISTRIBUTION'|'SPECIAL'
}

model Payment {
  id         String  @id @default(cuid())
  saleId     String
  sale       Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  formaPago  String  // 01=Efectivo 02=Tarjeta débito 03=Tarjeta crédito ...
  amount     Decimal @db.Decimal(10, 2)
  reference  String?

  @@index([saleId])
}

// ─── DTE ─────────────────────────────────────────────────────────────────────

model DteDocument {
  id               String    @id @default(cuid())
  tenantId         String
  companyId        String
  branchId         String
  saleId           String    @unique
  sale             Sale      @relation(fields: [saleId], references: [id])
  tipoDte          String
  numeroControl    String
  codigoGeneracion String    @unique
  jsonOriginal     Json?
  jsonFirmado      String?
  selloRecibido    String?
  status           DteStatus @default(PENDING)
  observaciones    String[]
  invalidacionCodigoGeneracion String?
  invalidacionJson             Json?
  invalidacionJsonFirmado      String?
  invalidacionSelloRecibido    String?
  invalidationReason           String?
  invalidatedAt                DateTime?
  // Contingencia: campos del DTE emitido fuera de línea (para re-emisión con tipoModelo=2)
  tipoContingenciaEmision  Int?     // CAT-005: 1-5, si fue emitido en contingencia
  motivoContingenciaEmision String? // Motivo de contingencia declarado al momento de emisión
  // Evento Retorno (Tipo 18) — DTE 2.0 — vigencia dic 2026
  retornoCodigoGeneracion      String?
  retornoJson                  Json?
  retornoJsonFirmado           String?
  retornoSelloRecibido         String?
  retornoMotivo                String?
  retornoAt                    DateTime?
  // Evento Operaciones Especiales (Tipo 17) — DTE 2.0 — vigencia dic 2026
  opEspecialCodigoGeneracion   String?
  opEspecialJson               Json?
  opEspecialJsonFirmado        String?
  opEspecialSelloRecibido      String?
  opEspecialTipoOperacion      String?  // CAT-022
  opEspecialMotivo             String?
  opEspecialAt                 DateTime?
  processedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([tenantId, companyId])
  @@index([tenantId, companyId, branchId])
  @@index([tenantId, status])
  @@index([tenantId, companyId, status, createdAt])
  @@index([tenantId, companyId, tipoDte, createdAt])
  @@index([tenantId, companyId, status, invalidatedAt])
}

model DteNumberControl {
  id            String   @id @default(cuid())
  tenantId      String
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId      String
  tipoDte       String
  year          Int      @default(2026) // resets sequence each calendar year
  lastSequence  Int      @default(0)
  codEstable    String
  codPuntoVenta String
  updatedAt     DateTime @updatedAt

  @@unique([companyId, branchId, tipoDte, year])
  @@index([tenantId, companyId])
}

// ─── Phase 3: Compras ─────────────────────────────────────────────────────────

model Supplier {
  id                       String   @id @default(cuid())
  tenantId                 String
  companyId                String
  company                  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                     String
  contactName              String?
  email                    String?
  phone                    String?
  address                  String?
  departamentoCod          String?
  municipioCod             String?
  distritoCod              String?
  nit                      String?
  nrc                      String?
  tipoDocumento            String?
  actividadEconomica       String?
  actividadEconomicaCodigo String?
  paymentTermDays          Int      @default(30)
  notes                    String?
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  purchaseOrders  PurchaseOrder[]
  accountsPayable AccountPayable[]

  @@index([tenantId, companyId])
}

model PurchaseOrder {
  id             String              @id @default(cuid())
  tenantId       String
  companyId      String
  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplierId     String
  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  orderNumber    String
  status         PurchaseOrderStatus @default(DRAFT)
  expectedDate   DateTime?
  receivedDate   DateTime?
  subtotal       Decimal             @default(0) @db.Decimal(10, 2)
  tax            Decimal             @default(0) @db.Decimal(10, 2)
  total          Decimal             @default(0) @db.Decimal(10, 2)
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  items              PurchaseOrderItem[]
  accountsPayable    AccountPayable[]
  inventoryMovements InventoryMovement[]

  @@index([tenantId, companyId])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Service       @relation(fields: [productId], references: [id])
  productName     String
  quantity        Decimal       @db.Decimal(10, 4)
  unitCost        Decimal       @db.Decimal(10, 4)
  total           Decimal       @db.Decimal(10, 2)
  receivedQty     Decimal       @default(0) @db.Decimal(10, 4)
}

model AccountPayable {
  id              String               @id @default(cuid())
  tenantId        String
  companyId       String
  company         Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId        String?
  branch          Branch?              @relation(fields: [branchId], references: [id])
  supplierId      String
  supplier        Supplier             @relation(fields: [supplierId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id])
  description     String
  amount          Decimal              @db.Decimal(10, 2)
  amountPaid      Decimal              @default(0) @db.Decimal(10, 2)
  dueDate         DateTime
  status          AccountPayableStatus @default(PENDING)
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([tenantId, companyId])
  @@index([tenantId, companyId, branchId])
  @@index([tenantId, companyId, status])
}

model ExpenseCategory {
  id        String    @id @default(cuid())
  tenantId  String
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  color     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  expenses  Expense[]

  @@index([tenantId, companyId])
}

model Expense {
  id          String          @id @default(cuid())
  tenantId    String
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId    String?
  branch      Branch?         @relation(fields: [branchId], references: [id])
  categoryId  String?
  category    ExpenseCategory? @relation(fields: [categoryId], references: [id])
  description String
  amount      Decimal         @db.Decimal(10, 2)
  date        DateTime        @default(now())
  receiptUrl  String?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([tenantId, companyId])
  @@index([tenantId, companyId, branchId])
  @@index([tenantId, companyId, date])
}

// ─── Phase 4: RRHH ────────────────────────────────────────────────────────────

model Employee {
  id              String         @id @default(cuid())
  tenantId        String
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId        String?
  branch          Branch?        @relation(fields: [branchId], references: [id])
  firstName       String
  lastName        String
  dui             String?
  nit             String?
  nssIsss         String?        // Número ISSS
  nup             String?        // Número AFP
  email           String?
  phone           String?
  address         String?
  departamentoCod String?
  municipioCod    String?
  distritoCod     String?
  position        String         // Cargo
  department      String?
  salary          Decimal        @db.Decimal(10, 2)
  salaryType      String         @default("MONTHLY") // MONTHLY / DAILY / HOURLY
  hireDate        DateTime
  terminationDate DateTime?
  status          EmployeeStatus @default(ACTIVE)
  // Deducción AFP
  afpInstitution  String?        // "CONFIA" | "CRECER"
  // Foto
  photoUrl        String?
  // Grupos y comisiones
  groupId         String?        // grupo del vendedor (obligatorio al crear si enableCommissions)
  commissionType  String?        // 'A' | 'B' | 'BOTH' | null (sin comisión)
  employeeDiscount Decimal?      @db.Decimal(5, 2)  // % descuento al comprar productos de la empresa
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  cargoId         String?
  cargo           EmployeeCargo? @relation(fields: [cargoId], references: [id])
  group           EmployeeGroup? @relation(fields: [groupId], references: [id])
  payrollItems    PayrollItem[]
  salesAsSeller   Sale[]         @relation("SaleSeller")
  saleItemsAsSeller SaleItem[]   @relation("SaleItemSeller")
  commissions     CommissionRecord[]

  @@index([tenantId, companyId])
  @@index([tenantId, companyId, branchId])
}

model EmployeeCargo {
  id          String     @id @default(cuid())
  tenantId    String
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  nombre      String
  descripcion String?
  activo      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  employees   Employee[]

  @@unique([tenantId, companyId, nombre])
  @@index([tenantId, companyId])
  @@map("employee_cargos")
}

model EmployeeGroup {
  id          String    @id @default(cuid())
  tenantId    String
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  // Configuración de comisión tipo B para el grupo
  commissionType String?  // 'PERCENT_SOLD' | 'PERCENT_GOAL'
  commissionPct  Decimal? @db.Decimal(5, 2)  // % de comisión tipo B
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employees   Employee[]
  salesGoals  SalesGoal[]

  @@unique([tenantId, companyId, name])
  @@index([tenantId, companyId])
  @@map("employee_groups")
}

model PayrollPeriod {
  id          String        @id @default(cuid())
  tenantId    String
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String        // e.g. "Mayo 2026"
  periodType  String        @default("MONTHLY") // MONTHLY | BIWEEKLY
  startDate   DateTime
  endDate     DateTime
  payDate     DateTime
  status      PayrollStatus @default(DRAFT)
  totalBruto  Decimal       @default(0) @db.Decimal(10, 2)
  totalNeto   Decimal       @default(0) @db.Decimal(10, 2)
  totalIsss   Decimal       @default(0) @db.Decimal(10, 2)
  totalAfp    Decimal       @default(0) @db.Decimal(10, 2)
  totalRenta  Decimal       @default(0) @db.Decimal(10, 2)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  items PayrollItem[]

  @@index([tenantId, companyId])
}

model PayrollItem {
  id              String        @id @default(cuid())
  tenantId        String
  payrollPeriodId String
  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id])
  // Ingresos
  salaryBase      Decimal       @db.Decimal(10, 2)
  horasExtra      Decimal       @default(0) @db.Decimal(10, 2)
  bonos           Decimal       @default(0) @db.Decimal(10, 2)
  comisiones      Decimal       @default(0) @db.Decimal(10, 2)  // comisiones tipo A + B del período
  aguinaldo       Decimal       @default(0) @db.Decimal(10, 2)
  otrosIngresos   Decimal       @default(0) @db.Decimal(10, 2)
  totalBruto      Decimal       @db.Decimal(10, 2)
  // Deducciones laborales (employee side)
  isssEmpleado    Decimal       @default(0) @db.Decimal(10, 2)  // 3%
  afpEmpleado     Decimal       @default(0) @db.Decimal(10, 2)  // 7.25%
  rentaRetenida   Decimal       @default(0) @db.Decimal(10, 2)  // ISR tabla
  otrosDeducciones Decimal      @default(0) @db.Decimal(10, 2)
  totalDeducciones Decimal      @db.Decimal(10, 2)
  salarioNeto     Decimal       @db.Decimal(10, 2)
  // Aportes patronales (employer side)
  isssPatronal    Decimal       @default(0) @db.Decimal(10, 2)  // 7.5%
  afpPatronal     Decimal       @default(0) @db.Decimal(10, 2)  // 7.75%
  insaforp        Decimal       @default(0) @db.Decimal(10, 2)  // 1%
  createdAt       DateTime      @default(now())

  @@index([payrollPeriodId])
  @@index([employeeId])
}

// ─── Sales Goals & Commissions ───────────────────────────────────────────────

model SalesGoal {
  id              String         @id @default(cuid())
  tenantId        String
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  groupId         String?        // null = meta global (aplica a todos los grupos)
  group           EmployeeGroup? @relation(fields: [groupId], references: [id])
  name            String
  startDate       DateTime
  endDate         DateTime
  targetAmount    Decimal        @db.Decimal(10, 2)
  // Comisión tipo B: base de cálculo
  commissionBasis String         @default("SOLD")   // 'SOLD' = % del monto vendido | 'GOAL' = % del monto meta
  commissionPct   Decimal        @default(0) @db.Decimal(5, 2)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([tenantId, companyId])
  @@index([tenantId, companyId, groupId])
  @@index([tenantId, companyId, startDate, endDate])
  @@map("sales_goals")
}

model CommissionRecord {
  id            String    @id @default(cuid())
  tenantId      String
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id])
  saleId        String?
  sale          Sale?     @relation(fields: [saleId], references: [id])
  saleItemId    String?   // para tipo A (por ítem específico)
  type          String    // 'A' | 'B'
  amount        Decimal   @db.Decimal(10, 4)
  payrollItemId String?   // id del PayrollItem cuando se pagó en planilla
  isPaid        Boolean   @default(false)
  periodStart   DateTime?
  periodEnd     DateTime?
  notes         String?
  createdAt     DateTime  @default(now())

  @@index([tenantId, companyId])
  @@index([tenantId, companyId, employeeId])
  @@index([tenantId, companyId, isPaid])
  @@map("commission_records")
}

// ─── Audit ───────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String?
  action    String
  entity    String
  entityId  String?
  payload   Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([tenantId, companyId])
  @@index([tenantId, companyId, entity])
}

// ─── Catálogos DTE (globales — sin tenantId, editables desde Configuración) ──

model Departamento {
  id        String       @id @default(cuid())
  codigo    String       @unique  // CAT-012 Hacienda (ej. "06")
  nombre    String
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  municipios Municipio[]
  distritos  Distrito[]
}

model Municipio {
  id             String       @id @default(cuid())
  codigo         String                           // código dentro del depto (ej. "01")
  nombre         String
  departamentoCod String
  departamento   Departamento @relation(fields: [departamentoCod], references: [codigo], onDelete: Cascade)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([departamentoCod, codigo])
  @@index([departamentoCod])
}

model Distrito {
  id              String       @id @default(cuid())
  codigo          String
  nombre          String
  departamentoCod String
  departamento    Departamento @relation(fields: [departamentoCod], references: [codigo], onDelete: Cascade)
  municipioCod    String?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([departamentoCod, codigo])
  @@index([departamentoCod])
  @@index([departamentoCod, municipioCod])
}

model ActividadEconomica {
  id        String   @id @default(cuid())
  codigo    String   @unique   // Código CIIU / Hacienda
  nombre    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Phase 5: Inventario / Kardex ────────────────────────────────────────────

model InventoryMovement {
  id             String                @id @default(cuid())
  tenantId       String
  companyId      String
  company        Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?               @relation(fields: [branchId], references: [id])
  productId      String
  product        Service               @relation(fields: [productId], references: [id])
  userId         String
  user           User                  @relation(fields: [userId], references: [id])
  type           InventoryMovementType
  quantity       Decimal               @db.Decimal(10, 4) // always positive
  quantityBefore Decimal               @db.Decimal(10, 4) // stock before
  quantityAfter  Decimal               @db.Decimal(10, 4) // stock after
  unitCost       Decimal?              @db.Decimal(10, 4)
  reference      String?               // OC number, sale number, etc.
  reason         String?               // description for manual adjustments
  // Optional links
  saleId          String?
  sale            Sale?          @relation(fields: [saleId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  createdAt       DateTime       @default(now())

  @@index([tenantId, companyId])
  @@index([tenantId, companyId, branchId])
  @@index([tenantId, productId])
  @@index([tenantId, companyId, createdAt])
  @@index([tenantId, companyId, type])
}

// ─── Phase 5: CxC — Cuentas por Cobrar ───────────────────────────────────────

model BranchInventory {
  id        String   @id @default(cuid())
  tenantId  String
  companyId String
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  productId String
  product   Service  @relation(fields: [productId], references: [id], onDelete: Cascade)
  stock     Decimal  @default(0) @db.Decimal(12, 4)
  minStock  Decimal  @default(0) @db.Decimal(12, 4)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, branchId, productId])
  @@index([tenantId, companyId, branchId])
  @@index([tenantId, companyId, productId])
}

model AccountReceivable {
  id          String                   @id @default(cuid())
  tenantId    String
  companyId   String
  company     Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId    String?
  branch      Branch?                  @relation(fields: [branchId], references: [id])
  clientId    String
  client      Client                   @relation(fields: [clientId], references: [id])
  saleId      String?                  @unique
  sale        Sale?                    @relation(fields: [saleId], references: [id])
  description String
  amount      Decimal                  @db.Decimal(10, 2)  // monto original
  amountPaid  Decimal                  @default(0) @db.Decimal(10, 2)
  dueDate     DateTime
  status      AccountReceivableStatus  @default(PENDING)
  notes       String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  payments    ArPayment[]

  @@index([tenantId, companyId])
  @@index([tenantId, companyId, branchId])
  @@index([tenantId, companyId, status])
  @@index([tenantId, companyId, dueDate])
  @@index([tenantId, clientId])
}

model ArPayment {
  id                  String            @id @default(cuid())
  tenantId            String
  accountReceivableId String
  accountReceivable   AccountReceivable @relation(fields: [accountReceivableId], references: [id], onDelete: Cascade)
  amount              Decimal           @db.Decimal(10, 2)
  paymentDate         DateTime          @default(now())
  paymentMethod       String            @default("01") // 01=Efectivo 02=Tarjeta ...
  reference           String?
  notes               String?
  createdAt           DateTime          @default(now())

  @@index([accountReceivableId])
  @@index([tenantId])
}
